margin:auto;
}

/* TOP BUTTON */

#topBtn{
position:fixed;
right:25px;
bottom:25px;
width:65px;
height:65px;
border:none;
border-radius:50%;
background:#00ff99;
color:black;
font-size:24px;
cursor:pointer;
display:none;
z-index:9999;
box-shadow:0 0 30px rgba(0,255,153,0.4);
}

/* RESPONSIVE */

@media(max-width:900px){

.nav-links{
display:none;
}

.menu-btn{
display:block;
}

.hero p{
font-size:1rem;
}

.section{
padding:110px 6%;
}

}

</style>
</head>
