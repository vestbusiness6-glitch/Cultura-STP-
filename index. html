<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title>São Tomé Turismo Premium</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;700;900&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  scroll-behavior:smooth;
}

body{
  font-family:'Poppins',sans-serif;
  background:black;
  color:white;
  overflow-x:hidden;
}

body::-webkit-scrollbar{
  width:10px;
}

body::-webkit-scrollbar-thumb{
  background:#00ff99;
  border-radius:20px;
}

::selection{
  background:#00ff99;
  color:black;
}

img{
  max-width:100%;
}

section{
  position:relative;
  width:100%;
}

/* NAVBAR */

.navbar{
  position:fixed;
  top:0;
  left:0;
  width:100%;
  z-index:999;
  padding:25px 8%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:rgba(0,0,0,.3);
  backdrop-filter:blur(12px);
}

.logo{
  font-size:2rem;
  font-weight:900;
  color:#00ff99;
}

.navbar nav{
  display:flex;
  gap:25px;
}

.navbar nav a{
  text-decoration:none;
  color:white;
  transition:.3s;
  font-weight:500;
}

.navbar nav a:hover{
  color:#00ff99;
}

/* HERO */

.hero{
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.hero img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  transform:scale(1.1);
}

.overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.65);
}

.hero-content{
  position:relative;
  z-index:10;
  text-align:center;
  max-width:1000px;
  padding:20px;
}

.small-title{
  color:#00ff99;
  letter-spacing:10px;
  text-transform:uppercase;
  margin-bottom:20px;
}

.main-title{
  font-size:clamp(4rem,10vw,9rem);
  font-weight:900;

  text-shadow:
  0 0 10px rgba(0,255,153,.5),
  0 0 30px rgba(0,255,153,.4),
  0 0 60px rgba(0,255,153,.3);
}

.sub-title{
  font-size:clamp(2rem,5vw,5rem);
  color:#00ff99;
  margin-top:15px;
}

.hero-text{
  margin-top:30px;
  color:#ddd;
  line-height:2;
  font-size:1.2rem;
}

/* BUTTONS */

.buttons{
  display:flex;
  justify-content:center;
  gap:20px;
  margin-top:50px;
  flex-wrap:wrap;
}

.btn{
  padding:18px 35px;
  border:none;
  border-radius:999px;
  cursor:pointer;
  font-weight:700;
  transition:.4s;
}

.btn-primary{
  background:#00ff99;
  color:black;
  box-shadow:0 0 30px rgba(0,255,153,.5);
}

.btn-primary:hover{
  transform:scale(1.08);
  background:white;
}

.btn-secondary{
  background:transparent;
  border:1px solid rgba(255,255,255,.3);
  color:white;
}

.btn-secondary:hover{
  background:white;
  color:black;
}

/* TITLES */

.section-title{
  text-align:center;
  margin-bottom:80px;
}

.section-title h2{
  font-size:clamp(3rem,7vw,6rem);
  font-weight:900;
  margin-bottom:20px;
}

.section-title p{
  max-width:700px;
  margin:auto;
  color:#aaa;
  line-height:2;
}

/* DESTINOS */

.destinations{
  padding:140px 8%;
}

.destination-card{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
  gap:70px;
  align-items:center;
  margin-bottom:140px;
}

.destination-image{
  overflow:hidden;
  border-radius:35px;
}

.destination-image img{
  width:100%;
  height:550px;
  object-fit:cover;
  transition:1s;
}

.destination-image:hover img{
  transform:scale(1.1);
}

.destination-content h3{
  font-size:clamp(2.5rem,5vw,5rem);
  margin-bottom:20px;
}

.destination-content p{
  color:#bbb;
  line-height:2;
  margin-bottom:35px;
}

.location{
  color:#00ff99;
  margin-bottom:20px;
  text-transform:uppercase;
}

/* HOTELS */

.cards-section{
  padding:140px 8%;
  background:#080808;
}

.cards-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:40px;
}

.card{
  background:#111;
  border-radius:35px;
  overflow:hidden;
  border:1px solid rgba(255,255,255,.08);
  transition:.5s;
}

.card:hover{
  transform:translateY(-15px);
  box-shadow:0 20px 50px rgba(0,255,153,.15);
}

.card img{
  width:100%;
  height:350px;
  object-fit:cover;
}

.card-content{
  padding:30px;
}

.card-content h3{
  margin-bottom:25px;
  font-size:2rem;
}

.hotel-buttons{
  display:flex;
  gap:15px;
  flex-wrap:wrap;
}

/* RESTAURANTS */

.restaurant-section{
  padding:140px 8%;
}

.restaurant-card{
  position:relative;
  overflow:hidden;
  border-radius:35px;
  height:500px;
}

.restaurant-card img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.restaurant-overlay{
  position:absolute;
  inset:0;
  display:flex;
  justify-content:end;
  flex-direction:column;
  padding:35px;
  background:linear-gradient(to top,rgba(0,0,0,.95),transparent);
}

.restaurant-overlay h3{
  font-size:2rem;
  margin-bottom:25px;
}

/* FINAL */

.final-section{
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

.final-bg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}

.final-overlay{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.7);
}

.final-content{
  position:relative;
  z-index:10;
  text-align:center;
  max-width:900px;
  padding:20px;
}

.final-content h2{
  font-size:clamp(4rem,8vw,8rem);
  margin-bottom:30px;
}

.final-content p{
  color:#ccc;
  line-height:2;
  margin-bottom:40px;
}

/* MODAL */

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.85);
  display:none;
  justify-content:center;
  align-items:center;
  z-index:99999;
  backdrop-filter:blur(10px);
}

.modal-box{
  width:90%;
  max-width:650px;
  background:#111;
  padding:40px;
  border-radius:30px;
  text-align:center;
  position:relative;
  border:1px solid rgba(255,255,255,.08);
}

.close-modal{
  position:absolute;
  top:20px;
  right:30px;
  font-size:2rem;
  cursor:pointer;
}

.modal-box h2{
  margin-bottom:20px;
  font-size:2.5rem;
}

.modal-box p{
  color:#ccc;
  line-height:2;
  margin-bottom:30px;
}

#copiedText{
  color:#00ff99;
  margin-top:20px;
}

/* RESPONSIVO */

@media(max-width:768px){

  .navbar nav{
    display:none;
  }

  .destination-image img{
    height:400px;
  }

  .restaurant-card{
    height:400px;
  }

}

</style>
</head>

<body>

<header class="navbar">

<div class="logo">São Tomé</div>

<nav>
<a href="#destinos">Destinos</a>
<a href="#hoteis">Hotéis</a>
<a href="#restaurantes">Restaurantes</a>
</nav>

</header>

<!-- HERO -->

<section class="hero">

<img
loading="lazy"
src="https://upload.wikimedia.org/wikipedia/commons/0/0f/Sao_Tome_Island.jpg"
alt="São Tomé">

<div class="overlay"></div>

<div class="hero-content">

<p class="small-title">Discover Paradise</p>

<h1 class="main-title">São Tomé</h1>

<h2 class="sub-title">Natureza • Cultura • Turismo</h2>

<p class="hero-text">
Explore as paisagens tropicais, cachoeiras, hotéis paradisíacos e restaurantes incríveis de São Tomé e Príncipe.
</p>

<div class="buttons">

<a href="#destinos">
<button class="btn btn-primary">
Explorar Agora
</button>
</a>

<a href="#hoteis">
<button class="btn btn-secondary">
Ver Hotéis
</button>
</a>

</div>

</div>

</section>

<!-- DESTINOS -->

<section class="destinations" id="destinos">

<div class="section-title reveal">
<h2>Destinos Reais</h2>

<p>
Explore os lugares naturais mais famosos de São Tomé e Príncipe.
</p>
</div>

<!-- SAO NICOLAU -->

<div class="destination-card reveal-left">

<div class="destination-image">

<img
loading="lazy"
src="https://upload.wikimedia.org/wikipedia/commons/5/55/Cascata_Sao_Nicolau.jpg"
alt="Cascata São Nicolau">

</div>

<div class="destination-content">

<p class="location">São Tomé & Príncipe</p>

<h3>Cascata São Nicolau</h3>

<p>
Uma das cascatas mais famosas de São Tomé rodeada por vegetação tropical exuberante.
</p>

<button class="btn btn-primary">
Explorar Local
</button>

</div>

</div>

<!-- OBO -->

<div class="destination-card reveal-right">

<div class="destination-content">

<p class="location">Parque Natural</p>

<h3>Parque Natural Obô</h3>

<p>
Florestas densas, biodiversidade rara e trilhas cinematográficas em meio à natureza.
</p>

<button class="btn btn-primary">
Ver Natureza
</button>

</div>

<div class="destination-image">

<img
loading="lazy"
src="https://upload.wikimedia.org/wikipedia/commons/e/e8/Obo_National_Park.jpg"
alt="Parque Natural Obô">

</div>

</div>

<!-- TERRA BATATA -->

<div class="destination-card reveal-left">

<div class="destination-image">

<img
loading="lazy"
src="https://upload.wikimedia.org/wikipedia/commons/8/81/Sao_Tome_Mountains.jpg"
alt="Terra Batata">

</div>

<div class="destination-content">

<p class="location">Montanhas</p>

<h3>Terra Batata</h3>

<p>
Região montanhosa de São Tomé conhecida pelo clima fresco e paisagens naturais incríveis.
</p>

<button class="btn btn-primary">
Descobrir Região
</button>

</div>

</div>

</section>

<!-- HOTELS -->

<section class="cards-section" id="hoteis">

<div class="section-title reveal">

<h2>Hotéis Reais</h2>

<p>
Conheça alguns dos hotéis mais famosos de São Tomé e Príncipe.
</p>

</div>

<div class="cards-grid">

<!-- HOTEL -->

<div class="card reveal-up">

<img
loading="lazy"
src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0e/6f/9d/0d/swimming-pool.jpg?w=1200&h=-1&s=1"
alt="Omali Lodge">

<div class="card-content">

<h3>Omali Lodge</h3>

<div class="hotel-buttons">

<button class="btn btn-primary"

onclick="openModal(
'Omali Lodge',
'Hotel luxuoso localizado próximo à praia com piscina, restaurante e ambiente tropical.',
'+239 222 2350'
)">

Ver Mais

</button>

<button
class="btn btn-secondary"
onclick="copyContact('+239 222 2350')">

Copiar Contato

</button>

</div>

</div>

</div>

<!-- HOTEL -->

<div class="card reveal-up">

<img
loading="lazy"
src="https://cf.bstatic.com/xdata/images/hotel/max1024x768/274860969.jpg"
alt="Pestana São Tomé">

<div class="card-content">

<h3>Pestana São Tomé</h3>

<div class="hotel-buttons">

<button class="btn btn-primary"

onclick="openModal(
'Pestana São Tomé',
'Hotel sofisticado à beira-mar com vista tropical e quartos premium.',
'+239 224 4500'
)">

Ver Mais

</button>

<button
class="btn btn-secondary"
onclick="copyContact('+239 224 4500')">

Copiar Contato

</button>

</div>

</div>

</div>

</div>

</section>

<!-- RESTAURANTES -->

<section class="restaurant-section" id="restaurantes">

<div class="section-title reveal">

<h2>Restaurantes</h2>

<p>
Descubra sabores únicos da gastronomia santomense.
</p>

</div>

<div class="cards-grid">

<!-- REST -->

<div class="restaurant-card reveal-scale">

<img
loading="lazy"
src="https://media-cdn.tripadvisor.com/media/photo-s/1a/55/e0/7e/papa-figo.jpg"
alt="Papa Figo">

<div class="restaurant-overlay">

<h3>Papa Figo</h3>

<div class="hotel-buttons">

<button class="btn btn-primary"

onclick="openModal(
'Papa Figo',
'Restaurante famoso pela culinária tropical e frutos do mar.',
'+239 990 8877'
)">

Ver Mais

</button>

<button
class="btn btn-secondary"
onclick="copyContact('+239 990 8877')">

Copiar Contato

</button>

</div>

</div>

</div>

<!-- REST -->

<div class="restaurant-card reveal-scale">

<img
loading="lazy"
src="https://media-cdn.tripadvisor.com/media/photo-s/19/8d/ce/4d/photo0jpg.jpg"
alt="Mionga">

<div class="restaurant-overlay">

<h3>Mionga Restaurant</h3>

<div class="hotel-buttons">

<button class="btn btn-primary"

onclick="openModal(
'Mionga Restaurant',
'Restaurante elegante com ambiente moderno e pratos locais.',
'+239 981 1122'
)">

Ver Mais

</button>

<button
class="btn btn-secondary"
onclick="copyContact('+239 981 1122')">

Copiar Contato

</button>

</div>

</div>

</div>

</div>

</section>

<!-- FINAL -->

<section class="final-section">

<img
class="final-bg"
src="https://upload.wikimedia.org/wikipedia/commons/4/4f/Sao_Tome_beach.jpg"
alt="Praia São Tomé">

<div class="final-overlay"></div>

<div class="final-content reveal">

<h2>Viva São Tomé</h2>

<p>
Uma experiência cinematográfica criada para mostrar ao mundo a beleza natural de São Tomé e Príncipe.
</p>

<button class="btn btn-primary">
Começar Experiência
</button>

</div>

</section>

<!-- MODAL -->

<div id="hotelModal" class="modal">

<div class="modal-box">

<span class="close-modal"
onclick="closeModal()">

&times;

</span>

<h2 id="modalTitle"></h2>

<p id="modalDescription"></p>

<button
class="btn btn-primary"
onclick="copyFromModal()">

Copiar Contato

</button>

<p id="copiedText"></p>

</div>

</div>

<!-- SCRIPT -->

<script>

gsap.registerPlugin(ScrollTrigger);

/* HERO */

gsap.from('.small-title',{
y:100,
opacity:0,
duration:1.2
});

gsap.from('.main-title',{
y:200,
opacity:0,
duration:1.5,
ease:'power4.out'
});

gsap.from('.sub-title',{
y:120,
opacity:0,
duration:1.5,
delay:.2
});

gsap.from('.hero-text',{
opacity:0,
y:60,
duration:1,
delay:.5
});

gsap.from('.buttons',{
opacity:0,
y:60,
duration:1,
delay:.8
});

/* REVEAL */

gsap.utils.toArray('.reveal').forEach((el)=>{

gsap.from(el,{
scrollTrigger:{
trigger:el,
start:'top 80%'
},
opacity:0,
y:100,
duration:1.3
});

});

gsap.utils.toArray('.reveal-left').forEach((el)=>{

gsap.from(el,{
scrollTrigger:{
trigger:el,
start:'top 80%'
},
opacity:0,
x:-200,
duration:1.4
});

});

gsap.utils.toArray('.reveal-right').forEach((el)=>{

gsap.from(el,{
scrollTrigger:{
trigger:el,
start:'top 80%'
},
opacity:0,
x:200,
duration:1.4
});

});

gsap.utils.toArray('.reveal-up').forEach((el)=>{

gsap.from(el,{
scrollTrigger:{
trigger:el,
start:'top 85%'
},
opacity:0,
y:120,
duration:1.2
});

});

gsap.utils.toArray('.reveal-scale').forEach((el)=>{

gsap.from(el,{
scrollTrigger:{
trigger:el,
start:'top 85%'
},
opacity:0,
scale:.7,
duration:1.2,
ease:'back.out(1.7)'
});

});

/* MODAL */

let currentContact = "";

function openModal(title,description,contact){

document.getElementById("hotelModal").style.display="flex";

document.getElementById("modalTitle").innerText=title;

document.getElementById("modalDescription").innerText=description;

document.getElementById("copiedText").innerText="";

currentContact=contact;
}

function closeModal(){

document.getElementById("hotelModal").style.display="none";
}

function copyContact(contact){

navigator.clipboard.writeText(contact);

alert("Contato copiado!");
}

function copyFromModal(){

navigator.clipboard.writeText(currentContact);

document.getElementById("copiedText").innerText =
"Contato copiado com sucesso!";
}

</script>

</body>
</html>
