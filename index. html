<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>São Tomé Turismo Premium</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:'Poppins',sans-serif;
background:#020202;
color:white;
overflow-x:hidden;
}

body::-webkit-scrollbar{
width:10px;
}

body::-webkit-scrollbar-thumb{
background:#00ff99;
border-radius:20px;
}

/* LOADER */

.loader{
position:fixed;
inset:0;
background:black;
display:flex;
justify-content:center;
align-items:center;
flex-direction:column;
z-index:999999;
}

.loader h1{
font-size:5rem;
font-weight:900;
color:#00ff99;
animation:pulse 1.5s infinite;
}

.loader p{
margin-top:20px;
letter-spacing:6px;
color:#ccc;
}

@keyframes pulse{
0%{opacity:0.3;transform:scale(0.95);}
50%{opacity:1;transform:scale(1.05);}
100%{opacity:0.3;transform:scale(0.95);}
}

/* NAVBAR */

.navbar{
position:fixed;
top:0;
left:0;
width:100%;
padding:18px 7%;
display:flex;
justify-content:space-between;
align-items:center;
z-index:9999;
background:rgba(0,0,0,0.45);
backdrop-filter:blur(20px);
border-bottom:1px solid rgba(255,255,255,0.08);
}

.logo{
font-size:1.5rem;
font-weight:900;
color:#00ff99;
}

.nav-links{
display:flex;
gap:30px;
}

.nav-links a{
text-decoration:none;
color:white;
font-weight:500;
transition:0.3s;
}

.nav-links a:hover{
color:#00ff99;
}

.menu-btn{
display:none;
font-size:2rem;
color:white;
cursor:pointer;
}

.mobile-menu{
position:fixed;
top:0;
right:-100%;
width:280px;
height:100vh;
background:#0b0b0b;
padding:120px 30px;
display:flex;
flex-direction:column;
gap:25px;
transition:0.5s;
z-index:99999;
}

.mobile-menu.active{
right:0;
}

.mobile-menu a{
text-decoration:none;
color:white;
font-size:1.2rem;
}

/* HERO */

.hero{
height:100vh;
position:relative;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
overflow:hidden;
}

.hero video{
position:absolute;
width:100%;
height:100%;
object-fit:cover;
}

.hero-overlay{
position:absolute;
inset:0;
background:rgba(0,0,0,0.65);
}

.floating{
position:absolute;
width:600px;
height:600px;
background:rgba(0,255,153,0.1);
filter:blur(120px);
border-radius:50%;
animation:float 6s infinite ease-in-out;
}

@keyframes float{
0%{transform:translateY(0);}
50%{transform:translateY(50px);}
100%{transform:translateY(0);}
}

.hero-content{
position:relative;
z-index:10;
padding:20px;
max-width:1100px;
}

.hero-small{
letter-spacing:10px;
text-transform:uppercase;
color:#00ff99;
margin-bottom:25px;
}

.hero h1{
font-size:clamp(4rem,10vw,9rem);
font-weight:900;
line-height:1;
}

.hero h2{
font-size:clamp(2rem,5vw,4rem);
margin-top:20px;
color:#00ff99;
}

.hero p{
margin-top:30px;
line-height:2;
font-size:1.1rem;
max-width:850px;
margin-inline:auto;
color:#ddd;
}

.hero-buttons{
margin-top:45px;
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

/* BUTTON */

.btn{
padding:18px 40px;
border:none;
border-radius:999px;
cursor:pointer;
font-weight:700;
transition:0.4s;
font-size:1rem;
text-decoration:none;
display:inline-flex;
align-items:center;
justify-content:center;
}

.btn-primary{
background:#00ff99;
color:black;
box-shadow:0 0 30px rgba(0,255,153,0.3);
}

.btn-primary:hover{
transform:translateY(-5px) scale(1.05);
background:white;
}

.btn-secondary{
background:transparent;
border:1px solid rgba(255,255,255,0.25);
color:white;
}

.btn-secondary:hover{
background:white;
color:black;
}

/* SEARCH */

.search-box{
margin:50px auto 0;
max-width:600px;
position:relative;
}

.search-box input{
width:100%;
padding:20px 25px;
border-radius:999px;
border:none;
outline:none;
font-size:1rem;
background:#111;
color:white;
border:1px solid rgba(255,255,255,0.08);
}

/* SECTION */

.section{
padding:130px 7%;
position:relative;
}

.section-title{
text-align:center;
margin-bottom:80px;
}

.section-title h2{
font-size:clamp(3rem,7vw,6rem);
font-weight:900;
margin-bottom:20px;
}

.section-title p{
max-width:850px;
margin:auto;
line-height:2;
color:#aaa;
}

/* SWIPER */

.swiper{
padding-bottom:60px;
}

/* CARD */

.card{
background:#0f0f0f;
border-radius:35px;
overflow:hidden;
transition:0.5s;
border:1px solid rgba(255,255,255,0.08);
}

.card:hover{
transform:translateY(-12px);
box-shadow:0 20px 60px rgba(0,255,153,0.12);
}

.card img{
width:100%;
height:350px;
object-fit:cover;
transition:1s;
}

.card:hover img{
transform:scale(1.08);
}

.card-content{
padding:30px;
}

.card-content h3{
font-size:2rem;
margin-bottom:15px;
}

.card-content p{
line-height:1.9;
color:#bbb;
margin-bottom:20px;
}

.stars{
color:#00ff99;
font-size:1.2rem;
margin-bottom:15px;
}

.more-info{
max-height:0;
overflow:hidden;
opacity:0;
transition:0.7s;
}

.more-info.active{
max-height:1000px;
opacity:1;
margin-top:25px;
}

.detail-text{
line-height:2;
color:#ddd;
margin-bottom:20px;
}

.copy-message{
margin-top:15px;
color:#00ff99;
display:none;
font-weight:600;
}

/* GALLERY */

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.gallery img{
width:100%;
height:320px;
object-fit:cover;
border-radius:30px;
transition:0.6s;
}

.gallery img:hover{
transform:scale(1.05);
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:30px;
margin-top:50px;
}

.stat-box{
background:#111;
padding:40px;
border-radius:30px;
text-align:center;
}

.stat-box h3{
font-size:3rem;
color:#00ff99;
margin-bottom:10px;
}

/* FOOTER */

footer{
padding:80px 7%;
background:black;
text-align:center;
border-top:1px solid rgba(255,255,255,0.08);
}

footer h2{
font-size:3rem;
margin-bottom:20px;
}

footer p{
color:#aaa;
line-height:2;
